# Connexion base de données (constructeur, aucune valeur réelle)
DATABASE_URL=
# Connexion Redis / BullMQ (aucune valeur réelle)
REDIS_URL=
# Durée d'expiration d'un paiement, en heures (vide = défaut spec v1.3)
PAYMENT_EXPIRATION_HOURS=
# Secrets de signature des webhooks entrants (un par provider, vides)
WEBHOOK_SECRET_SMARTPAY=
WEBHOOK_SECRET_LIPACASH=
WEBHOOK_SECRET_AIRTEL=
# Secrets de signature des webhooks sortants vers le marchand (vides)
WEBHOOK_OUTBOUND_SECRET=
WEBHOOK_OUTBOUND_URL=
# HTTP API (Bun.serve) : port, scénario Mock (success par défaut), rate limit
PORT=3456
MOCK_SCENARIO=
RATE_LIMIT_PER_MIN=60
# Retry sortant : planning + tentatives max (spec §8.2)
WEBHOOK_RETRY_SCHEDULE=1m,5m,15m,1h,6h,24h
WEBHOOK_MAX_RETRIES=6
# Session dashboard : durée de vie en heures
SESSION_TTL_HOURS=12
