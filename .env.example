# Payswitch v1 — variables d'environnement (spec §6.3, §8.2, US-11).
# Activation providers = config-driven (config/providers.ts + .env).
# Copier vers .env puis renseigner. Ne jamais commiter de vrais secrets.

# Connexion base de données (constructeur, aucune valeur réelle)
DATABASE_URL=
# Connexion Redis / BullMQ (aucune valeur réelle)
REDIS_URL=

# Fenêtre métier avant expiration : pending → expired, incertain → unknown,
# jamais failed (spec US-11, §9.2). Défaut 24 si vide.
PAYMENT_EXPIRATION_HOURS=

# Clés API et secrets de signature des webhooks entrants, un par provider
# réel v1 (spec §1.2 : Pawapay, CinetPay — Flutterwave en vague suivante).
PAWAPAY_API_KEY=
PAWAPAY_WEBHOOK_SECRET=
CINETPAY_API_KEY=
CINETPAY_WEBHOOK_SECRET=

# Retry des webhooks sortants vers le marchand (spec §8.2, US-10).
# Défauts si vides : "1m,5m,15m,1h,6h,24h" et 6.
WEBHOOK_RETRY_SCHEDULE=
WEBHOOK_MAX_RETRIES=
